<mxfile host="app.diagrams.net" agent="event-driven-serverless" type="device"><diagram id="arch" name="architecture"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;event-driven-serverless&lt;/b&gt;  &#8212; order processing: sync API path, async event path, every failure path named" style="text;html=1;fontSize=18;fontColor=#1F2328;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1200" height="30" as="geometry"/></mxCell><mxCell id="g_sync" value="Synchronous path" style="rounded=1;html=1;fillColor=#F6F8FA;strokeColor=#0969DA;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#0969DA;arcSize=6;" vertex="1" parent="1"><mxGeometry x="300" y="76" width="1060" height="128" as="geometry"/></mxCell><mxCell id="g_async" value="Asynchronous path" style="rounded=1;html=1;fillColor=#F6F8FA;strokeColor=#ED7100;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=12;fontColor=#BF6100;arcSize=6;" vertex="1" parent="1"><mxGeometry x="300" y="356" width="1060" height="348" as="geometry"/></mxCell><mxCell id="client" value="&lt;b&gt;POST /orders&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#57606A&quot;&gt;GET /orders&lt;/font&gt;" style="shape=label;html=1;whiteSpace=wrap;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#D0D7DE;image=data:image/svg+xml,;imageWidth=24;imageHeight=24;imageAlign=left;imageVerticalAlign=middle;spacingLeft=42;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2328;shadow=0;" vertex="1" parent="1"><mxGeometry x="40" y="112" width="210" height="64" as="geometry"/></mxCell><mxCell id="iac" value="&lt;b&gt;terraform/ · sam/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#57606A